# Copiar a .env y completar OPENAI_API_KEY (el .env NO se sube al repo: está en .gitignore).
#   cp .env.example .env
# Ningún nombre de modelo ni de índice está escrito en el código: salen de acá.
# Si falta una variable obligatoria, el sistema no arranca y el error dice cuál agregar.

# --- LLM (obligatorio) ---
# LLM_PROVIDER: openai | anthropic | gemini | ollama. El sistema se probó con openai / gpt-4o-mini:
# Phoenix calcula el costo de cada traza con los precios de ese modelo.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Solo si se cambia de proveedor (completar el par que corresponda):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
TEMPERATURE=0

# --- RAG híbrido sobre las fichas técnicas (data/*.md) ---
# Embeddings: openai | ollama | ninguno ("ninguno" = solo BM25, sin búsqueda vectorial)
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# Índice vectorial en Redis (también es el prefijo de sus claves). Se crea solo al arrancar;
# si cambian las fichas o el modelo de embeddings, se reconstruye solo (huella de versión).
RAG_INDICE=vw-fichas
# Fragmentos que recibe el Investigador por búsqueda (5: ver la evaluación en el README)
RAG_TOP_K=5
DATA_DIR=data

# --- Orquestador ---
# Intervenciones máximas de especialistas por turno (evita el "supervisor infinito")
MAX_PASOS=8
# Reparaciones por especialista antes de escalar a revisión humana
MAX_REPARACIONES=2
# Techo de pasos de LangGraph por ejecución (cada vuelta especialista -> validador -> supervisor usa 3)
RECURSION_LIMIT=40

# --- API, Redis y workers ---
# Con docker compose, REDIS_URL y PHOENIX_COLLECTOR_ENDPOINT se reemplazan por los nombres de los
# servicios (redis, phoenix). Estos valores son para correr la API en el venv.
REDIS_URL=redis://localhost:6379/0
# Jobs en paralelo por proceso worker (tareas asyncio)
WORKERS=5
# false (producción): la API solo encola y los workers son procesos aparte (servicio "worker" de
# docker compose, escalable con --scale worker=N). true: la API corre los workers en su event loop.
WORKER_EN_PROCESO=false
# Segundos sin latido tras los cuales otro worker retoma un job (el worker que lo tenía murió)
LEASE_S=30
# Techo de tiempo de una ejecución del grafo: si se pasa, el job queda FAILED
TIMEOUT_JOB_S=300

# --- Observabilidad (Arize Phoenix) ---
PHOENIX_HABILITADO=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-vw
